### Número del Siniestro sembrado duplicado, sin ADICIONAL → 409
POST {{baseUrl}}/api/siniestros
Content-Type: application/json

{
  "numeroSiniestro": "SIN-SEED-VALIDO-001",
  "fechaSiniestro": "2026-03-03T14:30:00.000Z",
  "gradoDano": "LEVE",
  "numeroPoliza": "POL-DOCS-DUPLICADO",
  "clienteId": "{{listarSiniestros.response.body.$.data[0].cliente.id}}",
  "vehiculoId": "{{listarSiniestros.response.body.$.data[0].vehiculo.id}}",
  "aseguradoraId": "{{listarSiniestros.response.body.$.data[0].aseguradora.id}}",
  "documentos": [
    { "tipo": "DENUNCIA", "referenciaArchivo": "docs/409/denuncia.jpg" },
    { "tipo": "LATERAL_DERECHA", "referenciaArchivo": "docs/409/lateral-derecha.jpg" },
    { "tipo": "LATERAL_IZQUIERDA", "referenciaArchivo": "docs/409/lateral-izquierda.jpg" },
    { "tipo": "FRONTAL", "referenciaArchivo": "docs/409/frontal.jpg" },
    { "tipo": "TRASERA", "referenciaArchivo": "docs/409/trasera.jpg" },
    { "tipo": "CERTIFICADO_COBERTURA", "referenciaArchivo": "docs/409/certificado.jpg" }
  ]
}


# No se incluye un request de relación inactiva: el seed deja activas las tres
# relaciones y producir ese estado requeriría ejecutar bajas lógicas ajenas a
# este incremento. El contrato y el handler sí contemplan el caso con 409.


###############################################################################
# PRESUPUESTOS
###############################################################################

### Listar Presupuestos con paginación por defecto → 200
# @name listarPresupuestos
GET {{baseUrl}}/api/presupuestos


### Listar Presupuestos con paginación explícita → 200
GET {{baseUrl}}/api/presupuestos?page=1&limit=5


### Paginación inválida → 400
GET {{baseUrl}}/api/presupuestos?page=0&limit=101


### Consultar el primer Presupuesto del listado → 200
# @name obtenerPresupuestoSembrado
GET {{baseUrl}}/api/presupuestos/{{listarPresupuestos.response.body.$.data[0].id}}


### ID de Presupuesto con formato inválido → 400
GET {{baseUrl}}/api/presupuestos/no-es-un-uuid


### Presupuesto inexistente → 404
GET {{baseUrl}}/api/presupuestos/{{uuidInexistente}}


### Crear un Presupuesto sin repuestos → 201
# Cambiar numeroPresupuesto si esta creación ya fue ejecutada.
POST {{baseUrl}}/api/presupuestos
Content-Type: application/json

{
  "numeroPresupuesto": "PRES-DOCS-POST-001",
  "siniestroId": "{{obtenerPresupuestoSembrado.response.body.$.siniestro.id}}",
  "reparaciones": [
    {
      "reparacionId": "{{obtenerPresupuestoSembrado.response.body.$.reparaciones[0].reparacion.id}}",
      "costo": "250000.00"
    }
  ]
}


### Crear un Presupuesto con repuestos → 201
# Cambiar numeroPresupuesto si esta creación ya fue ejecutada.
POST {{baseUrl}}/api/presupuestos
Content-Type: application/json

{
  "numeroPresupuesto": "PRES-DOCS-POST-002",
  "siniestroId": "{{obtenerPresupuestoSembrado.response.body.$.siniestro.id}}",
  "reparaciones": [
    {
      "reparacionId": "{{obtenerPresupuestoSembrado.response.body.$.reparaciones[0].reparacion.id}}",
      "costo": "300000.00"
    }
  ],
  "repuestos": [
    {
      "repuestoId": "{{obtenerPresupuestoSembrado.response.body.$.repuestos[0].repuesto.id}}",
      "cantidad": 1
    }
  ]
}


