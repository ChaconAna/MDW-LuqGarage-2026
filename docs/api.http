{
  "repuestos": [
    {
      "repuestoId": "{{obtenerPresupuestoSembrado.response.body.$.repuestos[0].repuesto.id}}",
      "cantidad": 3
    }
  ]
}


### Eliminar todos los Repuestos del Presupuesto en BORRADOR → 200
PATCH {{baseUrl}}/api/presupuestos/{{crearPresupuestoBorrador.response.body.$.id}}
Content-Type: application/json

{
  "repuestos": []
}


### PATCH de Presupuesto con body vacío → 400
PATCH {{baseUrl}}/api/presupuestos/{{crearPresupuestoBorrador.response.body.$.id}}
Content-Type: application/json

{}


### PATCH de Presupuesto con Reparaciones vacías → 400
PATCH {{baseUrl}}/api/presupuestos/{{crearPresupuestoBorrador.response.body.$.id}}
Content-Type: application/json

{
  "reparaciones": []
}


### Intentar modificar numeroPresupuesto → 400
PATCH {{baseUrl}}/api/presupuestos/{{crearPresupuestoBorrador.response.body.$.id}}
Content-Type: application/json

{
  "numeroPresupuesto": "PRES-DOCS-PATCH-NO-PERMITIDO"
}


### Intentar modificar siniestroId → 400
PATCH {{baseUrl}}/api/presupuestos/{{crearPresupuestoBorrador.response.body.$.id}}
Content-Type: application/json

{
  "siniestroId": "{{obtenerPresupuestoSembrado.response.body.$.siniestro.id}}"
}


### PATCH con Reparación inexistente → 404
PATCH {{baseUrl}}/api/presupuestos/{{crearPresupuestoBorrador.response.body.$.id}}
Content-Type: application/json

{
  "reparaciones": [
    {
      "reparacionId": "{{uuidInexistente}}",
      "costo": "100000.00"
    }
  ]
}


### PATCH con Repuesto inexistente → 404
PATCH {{baseUrl}}/api/presupuestos/{{crearPresupuestoBorrador.response.body.$.id}}
Content-Type: application/json

{
  "repuestos": [
    {
      "repuestoId": "{{uuidInexistente}}",
      "cantidad": 1
    }
  ]
}


### PATCH de Presupuesto inexistente → 404
PATCH {{baseUrl}}/api/presupuestos/{{uuidInexistente}}
Content-Type: application/json

{
  "repuestos": []
}


### PATCH del Presupuesto sembrado APROBADO → 409
PATCH {{baseUrl}}/api/presupuestos/{{obtenerPresupuestoSembrado.response.body.$.id}}
Content-Type: application/json

{
  "repuestos": []
}


### Registrar el envío externo del Presupuesto BORRADOR → 200 ENVIADO
# Ejecutar después de "Crear un Presupuesto sin repuestos".
# @name enviarPresupuesto
POST {{baseUrl}}/api/presupuestos/{{crearPresupuestoBorrador.response.body.$.id}}/enviar


### Registrar la aprobación externa del Presupuesto ENVIADO → 200 APROBADO
# Ejecutar después de "Registrar el envío externo del Presupuesto BORRADOR".
# @name aprobarPresupuesto
POST {{baseUrl}}/api/presupuestos/{{enviarPresupuesto.response.body.$.id}}/aprobar


### Registrar el envío del Presupuesto destinado al ejemplo de rechazo → 200
# Ejecutar después de "Crear un Presupuesto con repuestos".
# @name enviarPresupuestoParaRechazar
POST {{baseUrl}}/api/presupuestos/{{crearPresupuestoParaRechazar.response.body.$.id}}/enviar


### Registrar el rechazo externo del Presupuesto ENVIADO → 200 RECHAZADO
# Ejemplo separado del flujo aprobado. Ejecutar después del envío anterior.
# @name rechazarPresupuesto
POST {{baseUrl}}/api/presupuestos/{{enviarPresupuestoParaRechazar.response.body.$.id}}/rechazar


###############################################################################
# ÓRDENES DE TRABAJO
###############################################################################
# El seed actual deja una única OT FINALIZADA y su único Presupuesto APROBADO
# ya asociado. El flujo anterior crea y aprueba otro Presupuesto disponible,
# que permite encadenar los ejemplos de creación de una OT BORRADOR.

### Listar Órdenes de Trabajo con paginación por defecto → 200
# @name listarOrdenesTrabajo
GET {{baseUrl}}/api/ordenes-trabajo


### Listar Órdenes de Trabajo con paginación explícita → 200
GET {{baseUrl}}/api/ordenes-trabajo?page=1&limit=5


### Page inválido → 400
GET {{baseUrl}}/api/ordenes-trabajo?page=0


### Limit inválido → 400
GET {{baseUrl}}/api/ordenes-trabajo?limit=101


### Consultar la primera Orden de Trabajo del listado → 200
# @name obtenerOrdenTrabajoSembrada
GET {{baseUrl}}/api/ordenes-trabajo/{{listarOrdenesTrabajo.response.body.$.data[0].id}}


### ID de Orden de Trabajo con formato inválido → 400
GET {{baseUrl}}/api/ordenes-trabajo/no-es-un-uuid


### Orden de Trabajo inexistente → 404
GET {{baseUrl}}/api/ordenes-trabajo/{{uuidInexistente}}


### Crear una Orden de Trabajo con Presupuestos aprobados disponibles → 201
# Requiere haber ejecutado el flujo BORRADOR → ENVIADO → APROBADO anterior.
# @name crearOrdenTrabajoBorrador
POST {{baseUrl}}/api/ordenes-trabajo
Content-Type: application/json

{
  "siniestroId": "{{aprobarPresupuesto.response.body.$.siniestro.id}}",
  "presupuestoIds": [
    "{{aprobarPresupuesto.response.body.$.id}}"
  ]
}


### Body de Orden de Trabajo inválido: Presupuesto repetido → 400
POST {{baseUrl}}/api/ordenes-trabajo
Content-Type: application/json

{
  "siniestroId": "{{obtenerOrdenTrabajoSembrada.response.body.$.siniestro.id}}",
  "presupuestoIds": [
    "{{obtenerOrdenTrabajoSembrada.response.body.$.presupuestos[0].id}}",
    "{{obtenerOrdenTrabajoSembrada.response.body.$.presupuestos[0].id}}"
  ]
}


### Siniestro inexistente → 404
POST {{baseUrl}}/api/ordenes-trabajo
Content-Type: application/json

{
  "siniestroId": "{{uuidInexistente}}",
  "presupuestoIds": [
    "{{obtenerOrdenTrabajoSembrada.response.body.$.presupuestos[0].id}}"
  ]
}


### Presupuesto inexistente → 404
POST {{baseUrl}}/api/ordenes-trabajo
Content-Type: application/json

{
  "siniestroId": "{{obtenerOrdenTrabajoSembrada.response.body.$.siniestro.id}}",
  "presupuestoIds": ["{{uuidInexistente}}"]
}


### Presupuesto RECHAZADO, no aprobado → 409
# Requiere haber ejecutado antes el ejemplo separado de rechazo.
POST {{baseUrl}}/api/ordenes-trabajo
Content-Type: application/json

{
  "siniestroId": "{{rechazarPresupuesto.response.body.$.siniestro.id}}",
  "presupuestoIds": ["{{rechazarPresupuesto.response.body.$.id}}"]
}


### Presupuesto ya asociado a otra Orden de Trabajo → 409
POST {{baseUrl}}/api/ordenes-trabajo
Content-Type: application/json

{
  "siniestroId": "{{obtenerOrdenTrabajoSembrada.response.body.$.siniestro.id}}",
  "presupuestoIds": [
    "{{obtenerOrdenTrabajoSembrada.response.body.$.presupuestos[0].id}}"
  ]
}


### Modificar una observación de la OT BORRADOR → 200
# Requiere haber ejecutado correctamente "Crear una Orden de Trabajo con
# Presupuestos aprobados disponibles".
PATCH {{baseUrl}}/api/ordenes-trabajo/{{crearOrdenTrabajoBorrador.response.body.$.id}}
Content-Type: application/json

{
  "sectores": [
    {
      "sectorId": "{{crearOrdenTrabajoBorrador.response.body.$.sectores[0].id}}",
      "observacion": "Priorizar lateral izquierdo"
    }
  ]
}


### Eliminar una observación mediante null → 200
PATCH {{baseUrl}}/api/ordenes-trabajo/{{crearOrdenTrabajoBorrador.response.body.$.id}}
Content-Type: application/json

{
  "sectores": [
    {
      "sectorId": "{{crearOrdenTrabajoBorrador.response.body.$.sectores[0].id}}",
      "observacion": null
    }
  ]
}


### PATCH con Sectores vacíos → 400
PATCH {{baseUrl}}/api/ordenes-trabajo/{{crearOrdenTrabajoBorrador.response.body.$.id}}
Content-Type: application/json

{
  "sectores": []
}


### PATCH de Orden de Trabajo inexistente → 404
PATCH {{baseUrl}}/api/ordenes-trabajo/{{uuidInexistente}}
Content-Type: application/json

{
  "sectores": [
    {
      "sectorId": "{{obtenerOrdenTrabajoSembrada.response.body.$.sectores[0].id}}",
      "observacion": "No debe persistirse"
    }
  ]
}


### PATCH con Sector inexistente → 404
PATCH {{baseUrl}}/api/ordenes-trabajo/{{crearOrdenTrabajoBorrador.response.body.$.id}}
Content-Type: application/json

{
  "sectores": [
    {
      "sectorId": "{{uuidInexistente}}",
      "observacion": null
    }
  ]
}


### PATCH de Orden de Trabajo FINALIZADA → 409
PATCH {{baseUrl}}/api/ordenes-trabajo/{{obtenerOrdenTrabajoSembrada.response.body.$.id}}
Content-Type: application/json

{
  "sectores": [
    {
      "sectorId": "{{obtenerOrdenTrabajoSembrada.response.body.$.sectores[0].id}}",
      "observacion": "No debe persistirse"
    }
  ]
}


### PATCH con Sector existente ajeno a la OT → 409
# Requiere reemplazar sectorId por un Sector existente que no pertenezca a la
# OT BORRADOR utilizada. No existe un endpoint público de catálogo de Sectores
# y el seed no garantiza un segundo Sector ajeno al conjunto de la OT creada.
PATCH {{baseUrl}}/api/ordenes-trabajo/{{crearOrdenTrabajoBorrador.response.body.$.id}}
Content-Type: application/json

{
  "sectores": [
    {
      "sectorId": "REEMPLAZAR-POR-UUID-DE-SECTOR-AJENO",
      "observacion": null
    }
  ]
}


### Agregar un Presupuesto aprobado disponible a una OT BORRADOR → 200
# Requiere reemplazar el valor por un Presupuesto APROBADO del mismo Siniestro
# que todavía no pertenezca a ninguna OT. Puede obtenerse creando otro
# Presupuesto y ejecutando sus endpoints de envío y aprobación.
POST {{baseUrl}}/api/ordenes-trabajo/{{crearOrdenTrabajoBorrador.response.body.$.id}}/presupuestos
Content-Type: application/json

{
  "presupuestoIds": [
    "REEMPLAZAR-POR-UUID-DE-PRESUPUESTO-APROBADO-DISPONIBLE"
  ]
}


### Incorporación con array vacío → 400
POST {{baseUrl}}/api/ordenes-trabajo/{{crearOrdenTrabajoBorrador.response.body.$.id}}/presupuestos
Content-Type: application/json

{
  "presupuestoIds": []
}


### Incorporación a Orden de Trabajo inexistente → 404
POST {{baseUrl}}/api/ordenes-trabajo/{{uuidInexistente}}/presupuestos
Content-Type: application/json

{
  "presupuestoIds": [
    "{{obtenerOrdenTrabajoSembrada.response.body.$.presupuestos[0].id}}"
  ]
}


### Incorporación de Presupuesto inexistente → 404
POST {{baseUrl}}/api/ordenes-trabajo/{{crearOrdenTrabajoBorrador.response.body.$.id}}/presupuestos
Content-Type: application/json

{
  "presupuestoIds": ["{{uuidInexistente}}"]
}


### Incorporación a Orden de Trabajo FINALIZADA → 409
POST {{baseUrl}}/api/ordenes-trabajo/{{obtenerOrdenTrabajoSembrada.response.body.$.id}}/presupuestos
Content-Type: application/json

{
  "presupuestoIds": [
    "{{obtenerOrdenTrabajoSembrada.response.body.$.presupuestos[0].id}}"
  ]
}


### Incorporación de Presupuesto no aprobado → 409
# Requiere haber ejecutado antes el ejemplo separado de rechazo.
POST {{baseUrl}}/api/ordenes-trabajo/{{crearOrdenTrabajoBorrador.response.body.$.id}}/presupuestos
Content-Type: application/json

{
  "presupuestoIds": ["{{rechazarPresupuesto.response.body.$.id}}"]
}


### Presupuesto que ya pertenece a esta Orden de Trabajo → 409
POST {{baseUrl}}/api/ordenes-trabajo/{{crearOrdenTrabajoBorrador.response.body.$.id}}/presupuestos
Content-Type: application/json

{
  "presupuestoIds": [
    "{{crearOrdenTrabajoBorrador.response.body.$.presupuestos[0].id}}"
  ]
}


### Presupuesto asociado a otra Orden de Trabajo → 409
# La OT BORRADOR de destino debe pertenecer al mismo Siniestro que el
# Presupuesto sembrado para obtener específicamente este conflicto.
POST {{baseUrl}}/api/ordenes-trabajo/{{crearOrdenTrabajoBorrador.response.body.$.id}}/presupuestos
Content-Type: application/json

{
  "presupuestoIds": [
    "{{obtenerOrdenTrabajoSembrada.response.body.$.presupuestos[0].id}}"
  ]
}


### Finalizar una Orden de Trabajo BORRADOR válida → 200
# Ejecutar después de los ejemplos que modifican la OT creada: al finalizarla
# ya no admitirá Presupuestos ni cambios de observaciones.
# @name finalizarOrdenTrabajoBorrador
POST {{baseUrl}}/api/ordenes-trabajo/{{crearOrdenTrabajoBorrador.response.body.$.id}}/finalizar


### Finalización con UUID inválido → 400
POST {{baseUrl}}/api/ordenes-trabajo/no-es-un-uuid/finalizar


### Finalización de Orden de Trabajo inexistente → 404
POST {{baseUrl}}/api/ordenes-trabajo/{{uuidInexistente}}/finalizar


### Finalización de Orden de Trabajo ya FINALIZADA → 409
POST {{baseUrl}}/api/ordenes-trabajo/{{obtenerOrdenTrabajoSembrada.response.body.$.id}}/finalizar


# Los conflictos por OT sin Presupuestos, Presupuestos no aprobados o
# Reparaciones sin sectorizar requieren fixtures de integración inconsistentes
# con las operaciones públicas actuales. Sus respuestas 409 están documentadas
# en docs/api.md; este archivo no inventa UUID ni altera la base para producirlos.
