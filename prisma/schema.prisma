// Modelo de datos de LuqGarage.
//
// Cada modelo de dominio de este archivo sale de `docs/spec.md`. Si aparece un
// campo que el spec no necesita, sobra; si el spec necesita un dato que no está,
// falta.
//
// El corte actual implementa los catálogos base, Aseguradora, Cliente, Vehiculo,
// Siniestro, su documentación asociada, Presupuesto y Orden de Trabajo.
//
// Después de cualquier cambio en este archivo:
//   npx prisma migrate dev --name <descripcion-del-cambio>
//
// Nunca se edita el SQL de una migración ya aplicada: se corrige con otra.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Vercel es serverless, así que hacen falta dos conexiones distintas:
  //   DATABASE_URL → el pooler, que la app usa en cada request
  //   DIRECT_URL   → la conexión directa, que usan las migraciones
  // Con una sola funciona en clase y se cae en producción por agotar
  // las conexiones de Postgres.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GradoDano {
  LEVE
  MODERADO
  GRAVE
}

enum EstadoSiniestro {
  REGISTRADO
  PRESUPUESTADO
}

enum TipoDocumentoSiniestro {
  DENUNCIA
  LATERAL_DERECHA
  LATERAL_IZQUIERDA
  FRONTAL
  TRASERA
  CERTIFICADO_COBERTURA
  ADICIONAL
}

enum EstadoPresupuesto {
  BORRADOR
  ENVIADO
  APROBADO
  RECHAZADO
}

enum EstadoOrdenTrabajo {
  BORRADOR
  FINALIZADA
}

// ¿El equipo eligió MongoDB? Se cambia el provider a "mongodb", se usa una
// connection string de MongoDB Atlas y se sincroniza con `prisma db push`
// en lugar de `prisma migrate dev`. El resto del proyecto no cambia.
// Ojo: con Mongo los ids llevan @map("_id") @db.ObjectId y la integridad
// referencial la garantiza el código, no la base.

// ---------------------------------------------------------------------------
// Catálogos base
//
// Todos usan UUID como identificador técnico, según la sección 4 del spec.
// `@db.Uuid` hace que PostgreSQL los almacene en su tipo UUID nativo.
// ---------------------------------------------------------------------------

// Una marca se identifica por un nombre único y puede agrupar varios modelos.
model Marca {
  id      String   @id @default(uuid()) @db.Uuid
  nombre  String   @unique
  modelos Modelo[]
}

// El nombre de un modelo es único dentro de su marca, pero puede repetirse en
// marcas diferentes. La FK vive en este lado porque cada modelo tiene una sola
// marca.
model Modelo {
  id        String     @id @default(uuid()) @db.Uuid
  nombre    String
  marca     Marca      @relation(fields: [marcaId], references: [id])
  marcaId   String     @db.Uuid
  vehiculos Vehiculo[]

  @@unique([marcaId, nombre])
}

// Catálogo de tipos de vehículo. Su nombre no puede repetirse.
model TipoVehiculo {
  id        String     @id @default(uuid()) @db.Uuid
  nombre    String     @unique
  vehiculos Vehiculo[]
}

// Una provincia se identifica por un nombre único y agrupa localidades.
model Provincia {
  id          String      @id @default(uuid()) @db.Uuid
  nombre      String      @unique
  localidades Localidad[]
}

// El nombre de una localidad es único dentro de su provincia, pero puede
// repetirse en provincias diferentes.
model Localidad {
  id          String    @id @default(uuid()) @db.Uuid
  nombre      String
  provincia   Provincia @relation(fields: [provinciaId], references: [id])
  provinciaId String    @db.Uuid
  clientes    Cliente[]

  @@unique([provinciaId, nombre])
}

// Los sectores organizan las reparaciones de una Orden de Trabajo. El spec
// define seis valores iniciales, que se incorporarán cuando se implemente el
// seed de catálogos.
model Sector {
  id                     String               @id @default(uuid()) @db.Uuid
  nombre                 String               @unique
  reparaciones           Reparacion[]
  ordenesTrabajoSectores OrdenTrabajoSector[]
}

// Cada reparación pertenece a un único sector. Su nombre es único en todo el
// catálogo.
model Reparacion {
  id                  String              @id @default(uuid()) @db.Uuid
  nombre              String              @unique
  sector              Sector              @relation(fields: [sectorId], references: [id])
  sectorId            String              @db.Uuid
  detallesPresupuesto DetalleReparacion[]

  @@index([sectorId])
}

// Catálogo de repuestos. No almacena precio, costo ni stock porque esos datos
// están fuera del alcance definido para el MVP.
model Repuesto {
  id                  String            @id @default(uuid()) @db.Uuid
  nombre              String            @unique
  detallesPresupuesto DetalleRepuesto[]
}

model Aseguradora {
  id         String      @id @default(uuid()) @db.Uuid
  nombre     String
  cuit       String      @unique
  telefono   String
  email      String
  direccion  String
  activo     Boolean     @default(true)
  siniestros Siniestro[]
}

model Cliente {
  id          String      @id @default(uuid()) @db.Uuid
  nombre      String
  apellido    String
  dni         String      @unique
  telefono    String
  email       String
  direccion   String
  activo      Boolean     @default(true)
  localidad   Localidad   @relation(fields: [localidadId], references: [id])
  localidadId String      @db.Uuid
  siniestros  Siniestro[]
}

model Vehiculo {
  id             String       @id @default(uuid()) @db.Uuid
  patente        String       @unique
  activo         Boolean      @default(true)
  modelo         Modelo       @relation(fields: [modeloId], references: [id])
  modeloId       String       @db.Uuid
  tipoVehiculo   TipoVehiculo @relation(fields: [tipoVehiculoId], references: [id])
  tipoVehiculoId String       @db.Uuid
  siniestros     Siniestro[]
}

model Siniestro {
  id              String               @id @default(uuid()) @db.Uuid
  numeroSiniestro String               @unique
  fechaSiniestro  DateTime
  fechaRegistro   DateTime             @default(now())
  gradoDano       GradoDano
  numeroPoliza    String
  estado          EstadoSiniestro      @default(REGISTRADO)
  cliente         Cliente              @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  clienteId       String               @db.Uuid
  vehiculo        Vehiculo             @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  vehiculoId      String               @db.Uuid
  aseguradora     Aseguradora          @relation(fields: [aseguradoraId], references: [id], onDelete: Restrict)
  aseguradoraId   String               @db.Uuid
  documentos      DocumentoSiniestro[]
  presupuestos    Presupuesto[]
  ordenesTrabajo  OrdenDeTrabajo[]

  @@index([clienteId])
  @@index([vehiculoId])
  @@index([aseguradoraId])
}

model DocumentoSiniestro {
  id                String                 @id @default(uuid()) @db.Uuid
  tipo              TipoDocumentoSiniestro
  referenciaArchivo String
  siniestro         Siniestro              @relation(fields: [siniestroId], references: [id], onDelete: Restrict)
  siniestroId       String                 @db.Uuid

  @@index([siniestroId])
}

model Presupuesto {
  id                String              @id @default(uuid()) @db.Uuid
  numeroPresupuesto String              @unique
  estado            EstadoPresupuesto   @default(BORRADOR)
  siniestro         Siniestro           @relation(fields: [siniestroId], references: [id], onDelete: Restrict)
  siniestroId       String              @db.Uuid
  reparaciones      DetalleReparacion[]
  repuestos         DetalleRepuesto[]
  ordenTrabajo      OrdenDeTrabajo?     @relation(fields: [ordenTrabajoId], references: [id], onDelete: Restrict)
  ordenTrabajoId    String?             @db.Uuid

  @@index([siniestroId])
  @@index([ordenTrabajoId])
}

model DetalleReparacion {
  id            String      @id @default(uuid()) @db.Uuid
  costo         Decimal     @db.Decimal(12, 2)
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Restrict)
  presupuestoId String      @db.Uuid
  reparacion    Reparacion  @relation(fields: [reparacionId], references: [id], onDelete: Restrict)
  reparacionId  String      @db.Uuid

  @@unique([presupuestoId, reparacionId])
  @@index([reparacionId])
}

model DetalleRepuesto {
  id            String      @id @default(uuid()) @db.Uuid
  cantidad      Int
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Restrict)
  presupuestoId String      @db.Uuid
  repuesto      Repuesto    @relation(fields: [repuestoId], references: [id], onDelete: Restrict)
  repuestoId    String      @db.Uuid

  @@unique([presupuestoId, repuestoId])
  @@index([repuestoId])
}

model OrdenDeTrabajo {
  id           String               @id @default(uuid()) @db.Uuid
  estado       EstadoOrdenTrabajo   @default(BORRADOR)
  siniestro    Siniestro            @relation(fields: [siniestroId], references: [id], onDelete: Restrict)
  siniestroId  String               @db.Uuid
  presupuestos Presupuesto[]
  sectores     OrdenTrabajoSector[]

  @@index([siniestroId])
}

model OrdenTrabajoSector {
  id             String         @id @default(uuid()) @db.Uuid
  observacion    String?
  ordenTrabajo   OrdenDeTrabajo @relation(fields: [ordenTrabajoId], references: [id], onDelete: Restrict)
  ordenTrabajoId String         @db.Uuid
  sector         Sector         @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  sectorId       String         @db.Uuid

  @@unique([ordenTrabajoId, sectorId])
  @@index([sectorId])
}
